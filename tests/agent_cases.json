    {
      "id": "cloning_multifragment_gibson_ready",
      "name": "Cloning: ordered multi-fragment Gibson design should preserve every junction",
      "category": "cloning",
      "tags": ["golden-case", "multi-fragment", "gibson"],
      "prompt": "请按结构化设置规划当前载体的多片段 Gibson 克隆方案。",
      "structuredInputs": {
        "method": "gibson",
        "fragments": [
          {
            "name": "Reporter",
            "sequence": "$fixture:default_insert_300"
          },
          {
            "name": "Linker cassette",
            "sequence": "$fixture:default_dna_520"
          }
        ],
        "leftHomology": "$fixture:left_homology_20",
        "rightHomology": "$fixture:right_homology_20",
        "homologyLength": 20
