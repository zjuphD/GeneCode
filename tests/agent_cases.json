    {
      "id": "agent_chat_explicit_workspace_sgrna",
      "name": "Agent: explicit workspace=sgrna should not be overridden by inference",
      "prompt": "design guides for this target",
      "workspace": "sgrna",
      "snapshot": {
        "lastWorkbenchPage": "cloning",
        "formState": {
          "sg": {
            "sequence": "$fixture:default_dna_520",
