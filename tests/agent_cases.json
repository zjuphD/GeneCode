      "id": "duplicate_execute_guard",
      "name": "Safety: duplicate execute requests must be rejected",
      "category": "safety",
      "tags": ["idempotency", "execute-guard"],
      "requestId": "$auto",
      "prompt": "帮我给当前序列设计 RT-qPCR 引物",
      "snapshot": {
        "lastWorkbenchPage": "rtqpcr",
        "formState": {
          "rt": {
            "query": "$fixture:default_dna_520",
