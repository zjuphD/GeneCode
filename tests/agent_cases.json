      "expect": {
        "workspace": "sgrna",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_sgrna"],
        "execute": true,
        "executeErrorContains": ["没有找到", "PAM"]
      }
    },
    {
      "id": "mutagenesis_reference_mismatch_guard",
      "name": "Mutagenesis: reference mismatch should fail before returning primers",
      "prompt": "帮我给当前模板做 A120T 点突变引物",
      "snapshot": {
        "lastWorkbenchPage": "mutation",
        "formState": {
          "mutation": {
