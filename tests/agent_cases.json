    {
      "id": "sgrna_no_pam_execute_guard",
      "name": "sgRNA: no PAM sequence should fail during deterministic tool execution",
      "prompt": "帮我为当前这段 DNA 设计 sgRNA",
      "snapshot": {
        "lastWorkbenchPage": "sgrna",
        "currentMode": "ko",
        "formState": {
          "sg": {
            "sequence": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "query": "",
            "label": "Harness no PAM target",
            "species": "Homo sapiens",
            "strain": "",
            "mode": "ko",
            "pamSet": "spcas9_ngg"
          }
        }
