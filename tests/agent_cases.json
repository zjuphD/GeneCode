{
  "version": 3,
  "description": "GeneCode Agent release-gate cases. The deterministic suite runs with LLM disabled and validates routing, execution safety, molecular invariants, review, and artifacts.",
  "defaults": {
    "llm": {
      "enabled": false
    }
  },
  "cases": [
    {
      "id": "rtqpcr_sequence_ready",
      "name": "RT-qPCR: sequence context should route and execute",
      "prompt": "帮我给当前序列设计 RT-qPCR 引物，先不用 TaqMan 探针",
      "snapshot": {
        "lastWorkbenchPage": "rtqpcr",
        "formState": {
          "rt": {
            "query": "$fixture:default_dna_520",
            "species": "Homo sapiens",
            "strain": "",
            "gdnaCheck": false,
            "includeProbe": false
          }
        }
      },
      "expect": {
        "workspace": "rtqpcr",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_rtqpcr"],
        "execute": true,
        "minResults": 1,
        "resultChecks": {
          "ampliconMin": 70,
          "ampliconMax": 160
        }
      }
    },
    {
      "id": "sgrna_sequence_ready",
      "name": "sgRNA: DNA sequence should route and execute",
      "prompt": "帮我为当前这段 DNA 设计 sgRNA，做 knock-out",
      "snapshot": {
        "lastWorkbenchPage": "sgrna",
        "currentMode": "ko",
        "formState": {
          "sg": {
            "sequence": "$fixture:default_dna_520",
            "query": "",
            "label": "Harness sgRNA target",
            "species": "Homo sapiens",
            "strain": "",
            "mode": "ko",
            "pamSet": "spcas9_ngg"
          }
        }
      },
      "expect": {
        "workspace": "sgrna",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_sgrna"],
        "execute": true,
        "minResults": 1
      }
    },
    {
      "id": "sirna_sequence_ready",
      "name": "siRNA: transcript sequence should route and execute",
      "prompt": "帮我为当前 mRNA 序列设计一组 siRNA，输出 dTdT overhang",
      "snapshot": {
        "lastWorkbenchPage": "sirna",
        "formState": {
          "sirna": {
            "sequence": "$fixture:default_dna_520",
            "query": "",
            "label": "Harness siRNA target",
            "species": "Homo sapiens",
            "strain": "",
            "duplexLength": 21,
            "overhangMode": "dtdt",
            "preferShared": false,
            "cdsOnly": false,
            "excludeHighRisk": false
          }
        }
      },
      "expect": {
        "workspace": "sirna",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_sirna"],
        "execute": true,
        "minResults": 1
      }
    },
    {
      "id": "cloning_gibson_ready",
      "name": "Cloning: Gibson inputs should route and execute",
      "prompt": "帮我用 Gibson 给这个 insert 设计克隆引物",
      "snapshot": {
        "lastWorkbenchPage": "cloning",
        "formState": {
          "cloning": {
            "sequence": "$fixture:default_insert_300",
            "label": "Harness insert",
            "method": "gibson",
            "leftHomology": "$fixture:left_homology_20",
            "rightHomology": "$fixture:right_homology_20",
            "homologyLength": 20
          }
        }
      },
      "expect": {
        "workspace": "cloning",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_cloning"],
        "execute": true,
        "minResults": 1,
        "recommendedMethod": "gibson"
      }
    },
    {
      "id": "mutagenesis_dna_ready",
      "name": "Mutagenesis: DNA point mutation should route and execute",
      "prompt": "帮我给当前模板做 C120T 点突变引物",
      "snapshot": {
        "lastWorkbenchPage": "mutation",
        "formState": {
          "mutation": {
            "sequence": "$fixture:default_dna_520",
            "label": "Harness C120T",
            "mode": "dna",
            "position": 120,
            "reference": "C",
            "alternate": "T"
          }
        }
      },
      "expect": {
        "workspace": "mutagenesis",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_mutagenesis"],
        "execute": true,
        "minResults": 1
      }
    },
    {
      "id": "cloning_gfp_missing_insert",
      "name": "Cloning: GFP without sequence should ask for insert",
      "prompt": "设计 GFP 的克隆引物，你帮我找",
      "snapshot": {
        "lastWorkbenchPage": "cloning",
        "formState": {
          "cloning": {}
        }
      },
      "expect": {
        "workspace": "cloning",
        "readyToExecute": false,
        "execute": false,
        "missingContains": ["insert", "序列"]
      }
    },
    {
      "id": "project_memory_cloning_continue",
      "name": "Memory: project-level cloning inputs should continue task",
      "prompt": "继续刚才的克隆任务，直接生成方案",
      "snapshot": {
        "lastWorkbenchPage": "cloning",
        "formState": {
          "cloning": {}
        },
        "agentMemory": {
          "project": {
            "version": 1,
            "projectId": "harness_memory_project",
            "name": "Harness remembered cloning project",
            "workspaces": {
              "cloning": {
                "inputs": {
                  "sequence": "$fixture:default_insert_300",
                  "label": "Remembered insert",
                  "method": "gibson",
                  "leftHomology": "$fixture:left_homology_20",
                  "rightHomology": "$fixture:right_homology_20",
                  "homologyLength": 20
                },
                "decisions": ["优先 Gibson"],
                "openQuestions": []
              }
            }
          }
        }
      },
      "expect": {
        "workspace": "cloning",
        "readyToExecute": true,
        "tools": ["parse_sequence", "design_cloning"],
        "execute": true,
        "minResults": 1,
        "recommendedMethod": "gibson"
      }
    },
    {
      "id": "rtqpcr_short_sequence_stops",
      "name": "RT-qPCR: short pasted sequence should ask for longer input",
      "prompt": "帮我给这段序列设计 RT-qPCR 引物",
      "snapshot": {
        "lastWorkbenchPage": "rtqpcr",
        "formState": {
          "rt": {
            "query": "ATGCGTACGTAGCTA",
            "species": "Homo sapiens",
