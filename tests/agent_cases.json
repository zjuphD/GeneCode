      "expect": {
        "workspace": "sgrna",
        "readyToExecute": true
      }
    },
    {
      "id": "agent_chat_fast_mode",
      "name": "Agent: fast runMode should skip LLM rewrite",
      "prompt": "帮我给当前序列设计 RT-qPCR 引物",
