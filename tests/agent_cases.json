    {
      "id": "stale_snapshot_execute_guard",
      "name": "Safety: execution must reject a plan created for an older sequence",
      "category": "safety",
      "tags": ["stale-context", "execute-guard"],
      "prompt": "帮我给当前序列设计 RT-qPCR 引物",
      "snapshot": {
        "lastWorkbenchPage": "rtqpcr",
        "formState": {
          "rt": {
            "query": "$fixture:default_dna_520",
            "species": "Homo sapiens",
            "gdnaCheck": false,
            "includeProbe": false
          }
        }
      },
      "executeOverrides": {
        "planSnapshotHash": "fnv1a64-v1:planned-document",
        "snapshot": {
          "documentHash": "fnv1a64-v1:changed-document"
        }
      },
      "expect": {
        "workspace": "rtqpcr",
        "readyToExecute": true,
        "execute": true,
        "executeErrorContains": ["序列已在规划后被修改", "重新规划"]
      }
    },
    {
      "id": "review_mode_execute_guard",
      "name": "Safety: review mode must never execute design tools",
      "category": "safety",
      "tags": ["permissions", "execute-guard"],
      "prompt": "帮我给当前序列设计 RT-qPCR 引物",
      "snapshot": {
        "lastWorkbenchPage": "rtqpcr",
        "formState": {
          "rt": {
            "query": "$fixture:default_dna_520",
            "species": "Homo sapiens",
            "gdnaCheck": false,
            "includeProbe": false
          }
        }
