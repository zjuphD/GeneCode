    "scripts"
  ],
  "scripts": {
    "smoke": "node ./scripts/smoke.mjs && ../../node_modules/.bin/vitest run --config ./scripts/vitest-smoke.config.mjs && node ./src/genecode/SequencePanel/SequencePanel.smoke.mjs"
  },
